[gd_scene format=3 uid="uid://rgrr5g7i8p38"]

[ext_resource type="ArrayMesh" uid="uid://cruj34i0oyjsx" path="res://assets/new_array_mesh.mesh" id="1_yf5gv"]

[sub_resource type="GDScript" id="GDScript_dg2ed"]
script/source = "extends Node3D

@onready var smesh = $MeshInstance3D
@onready var array = smesh.mesh.surface_get_arrays(0)
@onready var timer: Timer = $Timer
var total_verticies = PackedInt32Array()
var new = ArrayMesh.new()
var color
var material = StandardMaterial3D.new()

var copy = MeshInstance3D.new()

func _ready() -> void:
	
	
	var indices = array[Mesh.ARRAY_INDEX]
	if indices == null or indices.is_empty():
		indices = PackedInt32Array()
		for i in range(array[Mesh.ARRAY_VERTEX].size()):
			indices.append(i)
	
	
	
	for i in range(0, indices.size(), 3):
		await timer.timeout
		#print(indices[i], \", \", indices[i + 1], \", \", indices[i + 2])
		update_mesh(indices[i],indices[i+1],indices[i+2])
	
	

	
func update_mesh(x,y,z):
	#print(array[Mesh.ARRAY_INDEX])

	total_verticies.append_array(PackedInt32Array([x, y, z]))
	array[Mesh.ARRAY_INDEX] = total_verticies
	
	new.clear_surfaces()
	new.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, array) 
	copy.mesh = new
	copy.set_surface_override_material(0, material)
	if not copy.is_inside_tree():
		add_child(copy)
	material.albedo_color = Color(\"darkgreen\")
	material.cull_mode = BaseMaterial3D.CULL_DISABLED

	
	


#func _on_timer_timeout() -> void:
#func _process(delta: float) -> void:
	#copy.global_rotation_degrees.y +=5*delta
"

