[sub_resource type="GDScript" id="GDScript_eholh"]
script/source = "extends CharacterBody2D


const SPEED = 300.0
const JUMP_VELOCITY = -400.0


func _physics_process(delta: float) -> void:
	# Disable gravity for TopDownCharacter
	# if not is_on_floor():
	#	velocity += get_gravity() * delta

	# Disable jumping
	# if Input.is_action_just_pressed(\"ui_accept\") and is_on_floor():
	#	velocity.y = JUMP_VELOCITY

	# Allow movement in four directions, including up and down
	var direction := Input.get_vector(\"game_left\", \"game_right\", \"game_up\", \"game_down\")
	if direction:
		velocity = direction * SPEED
	else:
		velocity = velocity.move_toward(Vector2(0.0, 0.0), SPEED)

	move_and_slide()
"

